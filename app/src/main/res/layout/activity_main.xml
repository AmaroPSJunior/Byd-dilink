<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070d1e"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center_horizontal">

        <!-- Header: BYD Light HAL Diagnostic / Dolphin Plus -->
        <TextView
            android:id="@+id/txtHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔍 BYD LIGHT HAL DIAGNOSTIC"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#00e5ff"
            android:letterSpacing="0.05"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/txtVehicleInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BYD Dolphin Plus • DiLink 3.0/4.0 • Android 10 (API 29)"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textColor="#94a3b8"
            android:layout_marginBottom="16dp" />

        <!-- 1️⃣ SEÇÃO 1: BYD LIGHT HAL DEEP INSPECTOR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#0f172a"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1️⃣ HAL LIGHT INSPECTION (STRICT SAFE READ-ONLY)"
                android:textColor="#38bdf8"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Módulo de varredura profunda por reflexão da classe android.hardware.bydauto.light.BYDAutoLightDevice."
                android:textColor="#94a3b8"
                android:textSize="11sp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnRunHalInspector"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="🔍 BYD LIGHT HAL DEEP INSPECTOR"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:backgroundTint="#0284c7" />
        </LinearLayout>

        <!-- 2️⃣ SEÇÃO 2: VERIFICAÇÃO DE PERMISSÕES DA CENTRAL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#0f172a"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2️⃣ PERMISSÕES DA CENTRAL DILINK"
                android:textColor="#10b981"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Verificação de permissões do sistema sem escrita (CAR_POWERTRAIN, REAL_GET_TASKS, BYD_LIGHT, etc)."
                android:textColor="#94a3b8"
                android:textSize="11sp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnCheckPermissions"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="🛡️ VERIFICAÇÃO DE PERMISSÕES DA CENTRAL"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:backgroundTint="#059669" />
        </LinearLayout>

        <!-- 3️⃣ SEÇÃO 3: EXPORTAR RELATÓRIO COMPLETO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#0f172a"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3️⃣ EXPORTAÇÃO DE RELATÓRIO DIAGNÓSTICO"
                android:textColor="#a855f7"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Opções para cópia integral, divisão em partes (~30k chars), exportação em arquivo TXT e compartilhamento direto."
                android:textColor="#94a3b8"
                android:textSize="11sp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnExportReport"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="📋 COPIAR RELATÓRIO INTEGRAL"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:backgroundTint="#7c3aed"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnCopyInParts"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="🧩 COPIAR EM PARTES (~30K CHARS)"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:backgroundTint="#6d28d9"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnExportTxt"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="💾 EXPORTAR TXT"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:backgroundTint="#059669"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnShareTxt"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="📤 COMPARTILHAR"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:backgroundTint="#0284c7"
                    android:layout_marginStart="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- STATUS DO TRANSPORTE / DIAGNÓSTICO -->
        <TextView
            android:id="@+id/txtActiveTransport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Modo: STRICT SAFE READ-ONLY (Sem escrita)"
            android:textColor="#38bdf8"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp" />

        <!-- FEEDBACK E LOGS EM TEMPO REAL -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FEEDBACK VISUAL &amp; LOGS DE DIAGNÓSTICO:"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#64748b"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/txtLiveLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#030712"
            android:padding="12dp"
            android:text="Selecione uma das 3 opções acima para iniciar a verificação técnica na central DiLink..."
            android:textColor="#34d399"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="3dp" />

    </LinearLayout>
</ScrollView>
