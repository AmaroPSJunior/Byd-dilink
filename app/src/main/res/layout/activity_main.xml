<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0b1329"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- Header App -->
        <TextView
            android:id="@+id/txtAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BYD Dolphin Plus - DiLink Controller"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#00d2ff"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Controle de Luzes, CanBus e Serviços DiLink 4.0/5.0"
            android:textSize="12sp"
            android:textColor="#94a3b8"
            android:layout_marginBottom="16dp" />

        <!-- Status Cintos & Portas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#151e3f"
            android:padding="14dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/txtSeatbeltStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status Cintos: Carregando..."
                android:textColor="#f8fafc"
                android:textSize="14sp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/txtDoorsStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status Portas: Carregando..."
                android:textColor="#f8fafc"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Botão Principal: FORÇAR APAGAR TODAS AS LUZES -->
        <Button
            android:id="@+id/btnMasterTurnOffLights"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="⚡ FORÇAR APAGAR TODAS AS LUZES"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:backgroundTint="#dc2626"
            android:layout_marginBottom="10dp" />

        <!-- Fileira com Botões Secundários -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/btnTurnOnLights"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="💡 Ligar Luzes"
                android:textSize="13sp"
                android:textColor="#ffffff"
                android:backgroundTint="#1e293b"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnTotalBlackout"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="🌙 Blackout Tela"
                android:textSize="13sp"
                android:textColor="#00d2ff"
                android:backgroundTint="#0f172a"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- Botões de Diagnóstico e Permissão -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnRunDiagnostics"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="🔍 Teste DiLink"
                android:textSize="12sp"
                android:textColor="#38bdf8"
                android:backgroundTint="#0369a1"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnGrantPermission"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="⚙️ Permissão System"
                android:textSize="12sp"
                android:textColor="#facc15"
                android:backgroundTint="#854d0e"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- Log de Execução em Tempo Real -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DIAGNÓSTICO E RETORNO EM TEMPO REAL:"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#64748b"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/txtExecutionDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#070c1a"
            android:padding="12dp"
            android:text="Pronto para envio. Toque em 'FORÇAR APAGAR TODAS AS LUZES' para disparar os 5 canais redundantes."
            android:textColor="#34d399"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="3dp" />

    </LinearLayout>
</ScrollView>
