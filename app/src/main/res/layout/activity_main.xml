<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070d1e"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center_horizontal">

        <!-- Header: BYD Communication Lab / Dolphin Plus -->
        <TextView
            android:id="@+id/txtHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💡 BYD LIGHT COMMAND TESTER"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#00e5ff"
            android:letterSpacing="0.05"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/txtVehicleInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BYD Dolphin Plus • DiLink 3.0/4.0 • Android 10"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textColor="#94a3b8"
            android:layout_marginBottom="14dp" />

        <!-- PAINEL DE CONTROLE PRINCIPAL DE LUZES DILINK -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#0f172a"
            android:padding="14dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VARREDURA DE PROTOCOLOS DE ILUMINAÇÃO:"
                android:textColor="#38bdf8"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginBottom="10dp" />

            <!-- Botão 1: ACENDER TODAS AS LUZES -->
            <Button
                android:id="@+id/btnTurnOnAllLights"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="💡 TESTAR ACENDER LUZES (TODOS OS COMANDOS)"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:backgroundTint="#16a34a"
                android:layout_marginBottom="8dp" />

            <!-- Botão 2: APAGAR TODAS AS LUZES -->
            <Button
                android:id="@+id/btnTurnOffAllLights"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="🌙 TESTAR APAGAR LUZES (TODOS OS COMANDOS)"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:backgroundTint="#dc2626"
                android:layout_marginBottom="8dp" />

            <!-- Botão 3: PARAR VARREDURA -->
            <Button
                android:id="@+id/btnStopLightLoop"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="⏹️ PARAR VARREDURA EM ANDAMENTO"
                android:textSize="11sp"
                android:textColor="#f87171"
                android:backgroundTint="#450a0a"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ================================================ -->
        <!-- SEÇÃO NOVA: BYD INTERIOR LIGHT LAB (FASE 22) -->
        <!-- ================================================ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1e1b4b"
            android:padding="14dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚨 BYD INTERIOR LIGHT LAB (AUTOSERVICE / DEVICE 1023)"
                android:textColor="#a855f7"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginBottom="8dp" />

            <!-- Indicadores de Status -->
            <TextView
                android:id="@+id/txtLabStatusAutoservice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AUTOSERVICE: [ TOQUE EM INSPECT API ]"
                android:textColor="#cbd5e1"
                android:textSize="11sp"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/txtLabStatusManager"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="BYDAUTO MANAGER: [ TOQUE EM INSPECT API ]"
                android:textColor="#cbd5e1"
                android:textSize="11sp"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/txtLabStatusDevice1023"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DEVICE 1023: [ TOQUE EM READ INTERIOR ]"
                android:textColor="#cbd5e1"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:layout_marginBottom="10dp" />

            <!-- FIDs Mapeadas -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• INTERIOR LIGHT FID: 1330643002 (HEX: 0x4F50003A)\n• AMBIENT LIGHT FID: 1069547536 (HEX: 0x3FC00010)"
                android:textColor="#38bdf8"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:layout_marginBottom="12dp" />

            <!-- Botões Principais de Inspeção e Leitura -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btnInspectApi"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="🔍 INSPECT API"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:backgroundTint="#6d28d9"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnReadInterior"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="📖 READ INTERIOR"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:backgroundTint="#0284c7"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <!-- Trava de Segurança de Escrita -->
            <Button
                android:id="@+id/btnArmWriteTest"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="🔒 ARMAR TESTE DE ESCRITA (DESARMADO)"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#facc15"
                android:backgroundTint="#334155"
                android:layout_marginBottom="10dp" />

            <!-- Botões de Escrita Luz Interna (Controlados por Arming) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <Button
                    android:id="@+id/btnSetInterior1"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="💡 SET INTERIOR 1"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:backgroundTint="#15803d"
                    android:enabled="false"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnSetInterior2"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="🌙 SET INTERIOR 2"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:backgroundTint="#b91c1c"
                    android:enabled="false"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <!-- Controles Iluminação Ambiente (Níveis 1..5) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AMBIENT LIGHT BRIGHTNESS (FID 1069547536):"
                android:textColor="#cbd5e1"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <Button
                    android:id="@+id/btnAmbientL1"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="L1"
                    android:textSize="10sp"
                    android:enabled="false"
                    android:backgroundTint="#334155"
                    android:layout_marginEnd="2dp" />

                <Button
                    android:id="@+id/btnAmbientL2"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="L2"
                    android:textSize="10sp"
                    android:enabled="false"
                    android:backgroundTint="#334155"
                    android:layout_marginEnd="2dp" />

                <Button
                    android:id="@+id/btnAmbientL3"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="L3"
                    android:textSize="10sp"
                    android:enabled="false"
                    android:backgroundTint="#334155"
                    android:layout_marginEnd="2dp" />

                <Button
                    android:id="@+id/btnAmbientL4"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="L4"
                    android:textSize="10sp"
                    android:enabled="false"
                    android:backgroundTint="#334155"
                    android:layout_marginEnd="2dp" />

                <Button
                    android:id="@+id/btnAmbientL5"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="L5"
                    android:textSize="10sp"
                    android:enabled="false"
                    android:backgroundTint="#334155" />
            </LinearLayout>

            <!-- Confirmação Física no Veículo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONFIRMAÇÃO VISUAL FÍSICA NO CARRO:"
                android:textColor="#facc15"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPhysicalYes"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="🎉 LUZ MUDOU"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:backgroundTint="#16a34a"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnPhysicalNo"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="❌ LUZ NÃO MUDOU"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:backgroundTint="#dc2626"
                    android:layout_marginStart="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- PAINEL DE SELEÇÃO E EXECUÇÃO DINÂMICA DE COMANDOS SELECIONADOS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#0f172a"
            android:padding="14dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎯 EXECUÇÃO DINÂMICA DE COMANDO SELECIONADO:"
                android:textColor="#38bdf8"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/txtWorkingCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Selecione um comando para disparar individualmente na central:"
                android:textColor="#94a3b8"
                android:textSize="11sp"
                android:layout_marginBottom="8dp" />

            <!-- Dropdown Spinner de Comandos -->
            <Spinner
                android:id="@+id/spinnerCommands"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#1e293b"
                android:padding="8dp"
                android:layout_marginBottom="10dp" />

            <!-- Botões para Executar Comando Selecionado -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnExecuteSelectedOn"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="💡 ACENDER (1)"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:backgroundTint="#059669"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnExecuteSelectedOff"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="🌙 APAGAR (0)"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:backgroundTint="#b91c1c"
                    android:layout_marginStart="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Indicador de Progresso Visual em Tempo Real -->
        <LinearLayout
            android:id="@+id/panelProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1e293b"
            android:padding="12dp"
            android:layout_marginBottom="14dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtProgressStep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="[0/80] Executando comando..."
                android:textColor="#facc15"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progressBarLight"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:max="100"
                android:progress="0" />
        </LinearLayout>

        <!-- Botões de Ação Secundários e Diagnóstico -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btnRunDiscovery"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="🔍 Varredura HAL"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:backgroundTint="#0284c7"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnExportJson"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="📋 Exportar JSON"
                android:textSize="11sp"
                android:textColor="#a7f3d0"
                android:backgroundTint="#065f46"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- Status do Transporte Ativo -->
        <TextView
            android:id="@+id/txtActiveTransport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Transporte Ativo: HAL Reflection (BYDAutoLightDevice)"
            android:textColor="#38bdf8"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp" />

        <!-- Log de Execução em Tempo Real na Tela do Carro -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FEEDBACK VISUAL DE COMANDOS EXECUTADOS:"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#64748b"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/txtLiveLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#030712"
            android:padding="12dp"
            android:text="Toque em 'ACENDER LUZES' ou 'APAGAR LUZES' para testar sequencialmente todos os comandos conhecidos do DiLink..."
            android:textColor="#34d399"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="3dp" />

    </LinearLayout>
</ScrollView>
