<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070d1e"
    android:orientation="vertical">

    <!-- Header Fixo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center_horizontal"
        android:background="#0b1329">

        <TextView
            android:id="@+id/txtHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔍 BYD DILINK CONTROLLER &amp; DIAGNOSTIC"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#00e5ff"
            android:letterSpacing="0.03" />

        <TextView
            android:id="@+id/txtVehicleInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BYD Dolphin Plus • DiLink 3.0/4.0 • Android 10 (API 29)"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textColor="#94a3b8"
            android:layout_marginBottom="12dp" />

        <!-- NAVEGAÇÃO ENTRE ABAS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:background="#1e293b"
            android:padding="3dp">

            <Button
                android:id="@+id/btnTabDiagnostic"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="📋 DIAGNÓSTICO"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:backgroundTint="#0284c7" />

            <Button
                android:id="@+id/btnTabControls"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="🎛️ CONTROLES"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#94a3b8"
                android:backgroundTint="#334155" />
        </LinearLayout>
    </LinearLayout>

    <!-- ABA 1: DIAGNÓSTICO -->
    <ScrollView
        android:id="@+id/layoutTabDiagnostic"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 1️⃣ SEÇÃO 1: HAL DEEP INSPECTOR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#0f172a"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1️⃣ INSPEÇÃO PROFUNDA POR REFLEXÃO"
                    android:textColor="#38bdf8"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Módulo de varredura profunda de BYDAutoSettingDevice, BodyworkDevice e LightDevice (STRICT READ-ONLY)."
                    android:textColor="#94a3b8"
                    android:textSize="11sp"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btnRunHalInspector"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="🔍 EXECUTAR DIAGNÓSTICO COMPLETO"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:backgroundTint="#0284c7" />

                <Button
                    android:id="@+id/btnReadDrivingState"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:text="📖 LER ESTADO DO VEÍCULO (API BYD)"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:backgroundTint="#0f766e" />

                <Button
                    android:id="@+id/btnReadAccelerometer"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:text="📐 LER ACELERÔMETRO DA CENTRAL"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:backgroundTint="#475569" />

                <Button
                    android:id="@+id/btnOpenHvac"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:text="❄ ABRIR CLIMATIZAÇÃO NATIVA BYD"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:backgroundTint="#0369a1" />
            </LinearLayout>

            <!-- 2️⃣ SEÇÃO 2: PERMISSÕES -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#0f172a"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2️⃣ PERMISSÕES DA CENTRAL DILINK"
                    android:textColor="#10b981"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Verificação de permissões declaradas e no contexto em tempo de execução."
                    android:textColor="#94a3b8"
                    android:textSize="11sp"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btnCheckPermissions"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="🛡️ VERIFICAÇÃO DE PERMISSÕES DA CENTRAL"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:backgroundTint="#059669" />
            </LinearLayout>

            <!-- 3️⃣ SEÇÃO 3: EXPORTAÇÃO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#0f172a"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3️⃣ EXPORTAÇÃO DE RELATÓRIO DIAGNÓSTICO"
                    android:textColor="#a855f7"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Opções para cópia integral, divisão em partes (~30k chars), exportação em TXT e compartilhamento."
                    android:textColor="#94a3b8"
                    android:textSize="11sp"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btnExportReport"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="📋 COPIAR RELATÓRIO INTEGRAL"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:backgroundTint="#7c3aed"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnCopyInParts"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="🧩 COPIAR EM PARTES (~30K CHARS)"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:backgroundTint="#6d28d9"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnExportTxt"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:text="💾 EXPORTAR TXT"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#ffffff"
                        android:backgroundTint="#059669"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btnShareTxt"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:text="📤 COMPARTILHAR"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#ffffff"
                        android:backgroundTint="#0284c7"
                        android:layout_marginStart="4dp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/txtActiveTransport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Modo: STRICT SAFE READ-ONLY (Sem escrita)"
                android:textColor="#38bdf8"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/txtLiveLogs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#030712"
                android:padding="12dp"
                android:text="Aguardando execução do diagnóstico..."
                android:textColor="#34d399"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>
    </ScrollView>

    <!-- ABA 2: CONTROLES -->
    <ScrollView
        android:id="@+id/layoutTabControls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CONTROLES DO VEÍCULO"
                android:textColor="#38bdf8"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginBottom="2dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Comandos disponíveis e leituras em validação no veículo."
                android:textColor="#94a3b8"
                android:textSize="11sp"
                android:layout_marginBottom="14dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#0f172a"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PERSIANA DO TETO PANORÂMICO"
                    android:textColor="#38bdf8"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="10dp"
                    android:text="API OEM de posição (0–100%). O comando só é enviado com velocidade zero e marcha P confirmadas."
                    android:textColor="#cbd5e1"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                    <Button
                        android:id="@+id/btnOpenSunshade"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:text="ABRIR"
                        android:textColor="#ffffff"
                        android:backgroundTint="#059669" />

                    <Button
                        android:id="@+id/btnCloseSunshade"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="FECHAR"
                        android:textColor="#ffffff"
                        android:backgroundTint="#b91c1c" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtSunshadePercent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="POSIÇÃO DESEJADA: 0%"
                    android:textColor="#e2e8f0"
                    android:textStyle="bold"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/seekSunshadePosition"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="0"
                    android:contentDescription="Posição desejada da persiana, de zero a cem por cento" />

                <Button
                    android:id="@+id/btnApplySunshadePosition"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="APLICAR POSIÇÃO"
                    android:textColor="#ffffff"
                    android:backgroundTint="#0369a1" />

                <TextView
                    android:id="@+id/txtSunshadeStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="API identificada; nenhum comando de persiana enviado nesta sessão."
                    android:textColor="#94a3b8"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Atalhos oficiais OEM e estado de acesso real -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#0f172a"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CLIMATIZAÇÃO"
                    android:textColor="#38bdf8"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="10dp"
                    android:text="Ligar/desligar é executado pelo controle de energia do painel OEM e confirmado pela mudança de estado da própria interface. Ative o serviço de acessibilidade do app uma vez."
                    android:textColor="#cbd5e1"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnHvacOn"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="LIGAR AR-CONDICIONADO"
                    android:textColor="#ffffff"
                    android:backgroundTint="#059669" />

                <Button
                    android:id="@+id/btnHvacOff"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:text="DESLIGAR AR-CONDICIONADO"
                    android:textColor="#ffffff"
                    android:backgroundTint="#b91c1c" />

                <TextView
                    android:id="@+id/txtClimateCommandStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Nenhum comando de climatização confirmado nesta sessão."
                    android:textColor="#94a3b8"
                    android:textSize="11sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#0f172a"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ESTADO DO CINTO DO MOTORISTA"
                    android:textColor="#fbbf24"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="10dp"
                    android:text="Leitura somente pelo BYDAutoSafetyBeltDevice oficial: consulta o estado por área (motorista=1 conforme referência BYD). Nenhum comando de escrita é usado."
                    android:textColor="#cbd5e1"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnReadSeatbelt"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="LER CINTO DO MOTORISTA"
                    android:textColor="#ffffff"
                    android:backgroundTint="#0f766e" />

                <TextView
                    android:id="@+id/txtSeatbeltAccessStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Sensor ainda não consultado."
                    android:textColor="#fde68a"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#0f172a"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="LUZ INTERNA DO TETO / SALÃO"
                    android:textColor="#38bdf8"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="10dp"
                    android:text="Usa os métodos OEM de luz interna e informa o retorno e os valores brutos lidos depois. O estado bruto ainda não foi mapeado como confirmação física nesta versão do veículo."
                    android:textColor="#cbd5e1"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnInteriorLightOn"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="LIGAR LUZ INTERNA"
                    android:textColor="#ffffff"
                    android:backgroundTint="#059669" />

                <Button
                    android:id="@+id/btnInteriorLightOff"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:text="DESLIGAR LUZ INTERNA"
                    android:textColor="#ffffff"
                    android:backgroundTint="#b91c1c" />

                <TextView
                    android:id="@+id/txtInteriorLightProbe"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Nenhum comando de luz interna enviado nesta sessão."
                    android:textColor="#94a3b8"
                    android:textSize="11sp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <!-- REGISTRO DE EXECUÇÃO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ACESSO DIRETO AOS RECURSOS:"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#64748b"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/txtControlLogs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#030712"
                android:padding="12dp"
                android:text="Os comandos diretos aguardam permissões OEM de sistema."
                android:textColor="#38bdf8"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
