<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070d1e"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center_horizontal">

        <!-- Header: BYD Communication Lab -->
        <TextView
            android:id="@+id/txtHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔬 BYD COMMUNICATION LAB"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#00e5ff"
            android:letterSpacing="0.05"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/txtVehicleInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BYD Dolphin Plus • Carregando Firmware..."
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textColor="#94a3b8"
            android:layout_marginBottom="12dp" />

        <!-- Card de Transporte Ativo e Modo de Teste -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#0f172a"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/txtActiveTransport"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Transporte Ativo: HAL Reflection"
                android:textColor="#38bdf8"
                android:textStyle="bold"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtTestMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Modo: SAFE READ ONLY (Seguro)"
                android:textColor="#facc15"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Botões de Ação Principal do Laboratório -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/btnRunDiscovery"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="🔍 Varredura Completa"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:backgroundTint="#0284c7"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnTestBenchLight"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="⚡ Test Bench Luz"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:backgroundTint="#dc2626"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- Fileira Secundária de Ferramentas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btnExportJson"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="📋 Exportar JSON"
                android:textSize="11sp"
                android:textColor="#a7f3d0"
                android:backgroundTint="#065f46"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnSettingsPermission"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="⚙️ Permissão System"
                android:textSize="11sp"
                android:textColor="#fef08a"
                android:backgroundTint="#854d0e"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- Matriz de Descoberta de Transportes -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MATRIZ DE COMUNICAÇÃO (12 TRANSPORTES):"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#64748b"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/txtDiscoveryMatrixView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#030712"
            android:padding="10dp"
            android:text="Carregando matriz de transportes..."
            android:textColor="#38bdf8"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="12dp" />

        <!-- Log de Comunicação em Tempo Real -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LOG DE BAIXO NÍVEL (SEM SUPRESSÃO DE EXCEÇÕES):"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#64748b"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/txtLiveLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#030712"
            android:padding="10dp"
            android:text="Aguardando comandos..."
            android:textColor="#34d399"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp" />

    </LinearLayout>
</ScrollView>
